# Site
NEXT_PUBLIC_SITE_URL=https://rileymusil.com
# Leave empty for a custom domain or user/org site (user.github.io).
# For a project site, set the repo name: NEXT_PUBLIC_BASE_PATH=my-repo
NEXT_PUBLIC_BASE_PATH=

# Google Analytics 4 (create a property at https://analytics.google.com)
# Leave empty to keep analytics off, which is what local dev should do.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Sanity CMS (create a project at https://www.sanity.io/manage)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-08-17
# SANITY_API_READ_TOKEN=
